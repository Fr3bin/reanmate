# Atlas URI: keep credentials out of source control
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/reanmate?retryWrites=true&w=majority
MONGODB_DB_NAME=reanmate
# Atlas supports transactions; use false only for a standalone local MongoDB server.
MONGODB_TRANSACTIONS=true
# Set true only for local UI testing when Atlas network access is unavailable.
AUTH_MEMORY_FALLBACK=false

# Generate with: openssl rand -base64 48
BETTER_AUTH_SECRET=
# Browser-facing frontend origin (Next.js proxies /auth to NestJS).
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PORT=4000
HOST=127.0.0.1

# Email code sign-in. Local dev prints codes in the backend terminal when these are empty.
RESEND_API_KEY=
AUTH_EMAIL_FROM=ReanMate <auth@your-domain.com>
# Set to console for local testing without sending real email.
AUTH_EMAIL_DELIVERY=

# Google sign-in. Redirect URI in Google Cloud:
# http://localhost:3000/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
